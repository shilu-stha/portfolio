---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>Writing by {{ site.author | xml_escape }} on machine learning and engineering.</description>
    <link>{{ '/' | absolute_url }}</link>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    {%- comment -%} Posts are pages under posts/blog/, not _posts, so site.posts is empty. {%- endcomment -%}
    {% assign posts = site.pages | where: "category", "blog" | sort: "date" | reverse %}
    {% for post in posts limit:20 %}
      <item>
        <title>{{ post.title | strip_html | xml_escape }}</title>
        <description>{{ post.summary | default: post.content | strip_html | xml_escape | truncatewords: 50 }}</description>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <link>{{ post.url | absolute_url }}</link>
        <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      </item>
    {% endfor %}
  </channel>
</rss>
